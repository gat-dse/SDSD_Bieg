@startuml SDSD_architecture_report
!pragma layout smetana

hide empty members
skinparam shadowing false
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam packageBorderColor #777777
skinparam packageBackgroundColor #FAFAFA
skinparam classBorderColor #333333
skinparam classBackgroundColor #FFFFFF
skinparam noteBackgroundColor transparent
skinparam noteBorderColor transparent

package "Input data" {
  class MaterialDatabase <<database>> {
    {field} Environmental data (EPDs)*
    {field} Material properties*
    {field} cost and construction time
  }

  class SlabProperties <<database>> {
    Moment coefficients
    Deflection coefficients
    Frequency factors
  }
}

package "Materials" {
  abstract class Material
  class "Ready-mixed concrete*" as Concrete
  class "Reinforcing steel*" as Reinforcement
  class "Prestressing steel" as PrestressingSteel
  class "Timber*" as Timber
  class "TCC connector" as Connector
  class "Floor build-up material" as FloorMaterial

  Material <|-- Concrete
  Material <|-- Reinforcement
  Material <|-- PrestressingSteel
  Material <|-- Timber
  Material <|-- Connector
  Material <|-- FloorMaterial
}

package "Cross-sections" {
  abstract class Section {
    Geometry and stiffness
    Resistance
    Material quantities
  }
  class "Rectangular concrete*" as RectangularConcrete
  class "Post-tensioned concrete" as PostTensionedConcrete
  class "Rectangular timber*" as RectangularTimber
  class "Ribbed concrete*" as RibbedConcrete
  class "Ribbed timber*" as RibbedTimber
  class TCC

  Section <|-- RectangularConcrete
  RectangularConcrete <|-- PostTensionedConcrete
  Section <|-- RectangularTimber
  Section <|-- RibbedConcrete
  Section <|-- RibbedTimber
  Section <|-- TCC
}

package "Structural model" {
  class "Structural system*" as StructuralSystem {
    Span and support conditions
    Internal-force coefficients
  }
  class "Member*" as Member {
    ULS verification
    SLS verification
    Fire verification
  }
  class "Requirements*" as Requirements {
    Deflection and vibration limits
    Fire and acoustic requirements
  }
  class "Floor build-up" as FloorBuildUp {
    Automatically generated layers
    Acoustic verification
  }
}

package "Design process" {
  class "Optimiser*" as Optimiser {
    Varies cross-section parameters
    Design criterion:
    ULS, SLS1, SLS2, fire or ENV
  }
  class "Sustainability assessment" as SustainabilityAssessment {
    Sustainability assessment criteria:
    GWP, height and mass
    cost and construction time
  }
  class "Pairwise comparison" as PairwiseComparison {
    Monte Carlo sampling
    Relative performance ranking
  }
}

note "varies" as VariesLabel

MaterialDatabase ..> Material
SlabProperties ..> StructuralSystem

Section o-- Material

Member *-- Section
Member *-- StructuralSystem
Member o-- Requirements
Member o-- FloorBuildUp

Optimiser ..> Member : evaluates
Optimiser ..> VariesLabel
VariesLabel ..> Section
Optimiser --> SustainabilityAssessment : feasible designs
SustainabilityAssessment --> PairwiseComparison : criterion distributions

@enduml
